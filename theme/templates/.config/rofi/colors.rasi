// Generated by scripts/theme.sh from theme/palette.sh. Do not edit.
* {
    bg:     ${BG};
    bgalt:  ${BG_ALT};
    accent: ${ACCENT};
    fg:     ${FG};
    fgdim:  ${FG_DIM};
    urgent: ${URGENT};
}

// rofi does not resolve variables in placeholder-color
entry {
    placeholder-color: ${FG_MUTED};
}

* {
    fgmuted:      ${FG_MUTED};
    bg-overlay:   ${BG}e0;
    bgalt-glass:  ${BG_ALT}aa;
}
