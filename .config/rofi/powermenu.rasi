@import "colors.rasi"

* {
    font:             "JetBrains Mono 12";
    background-color: transparent;
    text-color:       @fg;
    margin:           0;
    padding:          0;
    spacing:          0;
}

window {
    fullscreen:       true;
    background-color: @bg-overlay;
}

mainbox {
    children: [spacer, listview, message, spacer];
    spacing:  32px;
}

spacer {
    expand: true;
}

listview {
    columns:      5;
    lines:        1;
    spacing:      28px;
    fixed-columns: true;
    expand:       false;
    margin:       0 26%;
}

element {
    orientation:      vertical;
    padding:          28px 0 22px;
    border:           2px;
    border-color:     @bgalt;
    border-radius:    24px;
    background-color: @bgalt-glass;
}

element selected {
    border-color:     @accent;
    background-color: @bgalt;
}

element selected normal {
    text-color: @accent;
}

element-text {
    horizontal-align: 0.5;
    text-color:       inherit;
}

message {
    expand: false;
}

textbox {
    horizontal-align: 0.5;
    text-color:       @fgmuted;
}
