[global]
# Display
monitor = 0
follow = none
origin = top-right
offset = (15, 40)
indicate_hidden = yes
padding = 16
horizontal_padding = 20
frame_width = 2
separator_height = 2
separator_color = frame
transparency = 0
sort = yes
idle_threshold = 120

# Text
font = monospace 12
markup = full
format = "<b>%s</b>\n%b"
alignment = left
word_wrap = yes
ellipsize = middle
stack_duplicates = true
show_indicators = yes

# Icons
icon_position = left
max_icon_size = 16

# History
sticky_history = yes
history_length = 20
always_run_script = true
title = Dunst
class = Dunst
startup_notification = false

# Colours are in dunstrc.d/50-colors.conf, generated from theme/palette.sh.
[urgency_low]
    timeout = 5

[urgency_normal]
    timeout = 10

[urgency_critical]
    timeout = 0
