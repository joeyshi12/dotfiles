# The wakeshell desktop shell (github.com/joeyshi12/wakeshell): wallpaper, bar, launcher,
# notifications and the rest. Started with the graphical session (uwsm starts
# graphical-session.target once dwl is up) and restarted a second after a crash.
[Unit]
Description=wakeshell desktop shell
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
# Installed with `cargo install`; uwsm also puts ~/.cargo/bin on the session PATH
ExecStart=%h/.cargo/bin/wakeshell
Restart=on-failure
RestartSec=1
# uwsm's slice for session components such as bars and notification daemons
Slice=session-graphical.slice

[Install]
WantedBy=graphical-session.target
