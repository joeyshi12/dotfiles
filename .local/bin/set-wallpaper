#!/bin/sh
# Set the wallpaper to the given image.
# Usage: set-wallpaper IMAGE
# In the Wayland session the image is linked to ~/.local/share/wallpaper and
# the swaybg unit is restarted. In X it is set with feh.
set -eu

image="$(realpath "$1")"
if [ -n "${WAYLAND_DISPLAY:-}" ]; then
    mkdir -p "${XDG_DATA_HOME:-${HOME}/.local/share}"
    ln -sfn "${image}" "${XDG_DATA_HOME:-${HOME}/.local/share}/wallpaper"
    systemctl --user restart swaybg.service
else
    feh --no-fehbg --bg-scale "${image}"
fi
