#!/bin/sh
# Set the wallpaper to the given image.
# Usage: set-wallpaper IMAGE
# Links the image to ~/.local/share/wallpaper and restarts the swaybg unit.
set -eu

image="$(realpath "$1")"
mkdir -p "${XDG_DATA_HOME:-${HOME}/.local/share}"
ln -sfn "${image}" "${XDG_DATA_HOME:-${HOME}/.local/share}/wallpaper"
systemctl --user restart swaybg.service
