#!/bin/sh
# Lock, log out, suspend, reboot or shut down, chosen from a rofi menu.
# Bound to Alt+Shift+x in dwl.
set -eu

choice="$(printf '%s\n' Lock Logout Suspend Reboot Shutdown \
    | rofi -dmenu -i -p Power -no-custom)" || exit 0

case "${choice}" in
Lock)     loginctl lock-session ;;
Logout)   uwsm stop ;;
Suspend)  systemctl suspend ;;
Reboot)   systemctl reboot ;;
Shutdown) systemctl poweroff ;;
esac
