#!/bin/sh
# dwl uses the monitor's 60 Hz preferred mode, so switch DP-2 to 165 Hz
wlr-randr --output DP-2 --mode 2560x1440@164.998993Hz >/dev/null 2>&1
swayidle -w &
# wakeshell runs as the wakeshell.service user unit, which uwsm starts
# with graphical-session.target and systemd restarts if it crashes
exec uwsm finalize
