#!/usr/bin/env python3
"""Screen-share picker for xdg-desktop-portal-wlr (chooser_type=dmenu).

The portal writes one line per source it can share on stdin:
    Monitor: <name> <description>
    Window: <title> (<identifier>)
and expects the chosen line back on stdout. Printing nothing cancels the share.

Shows a dimmed overlay with a preview tile per source. Hovering a tile highlights
it and clicking it shares it. Cancel, Esc or a click outside the card cancels.
"""
import json
import os
import re
import signal
import subprocess
import sys
import tempfile
from pathlib import Path

# gtk4-layer-shell must be loaded before libwayland-client, so re-run with it preloaded
LAYER_SHELL_LIB = "libgtk4-layer-shell.so"
if LAYER_SHELL_LIB not in os.environ.get("LD_PRELOAD", ""):
    os.environ["LD_PRELOAD"] = " ".join(filter(None, [os.environ.get("LD_PRELOAD"), LAYER_SHELL_LIB]))
    os.execv(sys.executable, [sys.executable, *sys.argv])

import gi  # noqa: E402

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("GdkPixbuf", "2.0")
gi.require_version("Gtk4LayerShell", "1.0")
gi.require_version("Graphene", "1.0")
from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Graphene, Gtk  # noqa: E402
from gi.repository import Gtk4LayerShell as LayerShell  # noqa: E402

PALETTE = Path.home() / ".dotfiles/theme/palette.sh"
THUMB_SCALE = 0.15
TILE_WIDTH, TILE_HEIGHT = 256, 144


def read_palette():
    colors = {"BG": "#0f1825", "BG_ALT": "#253447", "ACCENT": "#418aa2",
              "FG": "#e8f4f8", "FG_MUTED": "#96a3ae"}
    try:
        for line in PALETTE.read_text().splitlines():
            m = re.match(r"^([A-Z_][A-Z0-9_]*)='(#[0-9a-fA-F]{6})'", line)
            if m:
                colors[m.group(1)] = m.group(2)
    except OSError:
        pass
    return colors


def parse_sources(lines):
    sources = []
    for line in lines:
        if line.startswith("Monitor: "):
            name = line[len("Monitor: "):].split(" ", 1)[0]
            sources.append({"line": line, "kind": "screen", "name": name})
        elif line.startswith("Window: "):
            m = re.match(r"^Window: (.*) \(([^()]*)\)$", line)
            title, ident = (m.group(1), m.group(2)) if m else (line[len("Window: "):], "")
            sources.append({"line": line, "kind": "window", "title": title.strip(), "id": ident})
    # Screens first, as in Discord and Zoom
    return [s for s in sources if s["kind"] == "screen"] + [s for s in sources if s["kind"] == "window"]


def resolutions():
    try:
        outputs = json.loads(subprocess.run(["wlr-randr", "--json"], capture_output=True,
                                            text=True, timeout=2).stdout)
    except (OSError, ValueError, subprocess.SubprocessError):
        return {}
    result = {}
    for out in outputs:
        for mode in out.get("modes", []):
            if mode.get("current"):
                result[out["name"]] = f"{mode['width']}×{mode['height']}"
    return result


def capture_thumbnails(sources, directory):
    """Takes all previews in parallel, before the overlay is shown so it is not in them."""
    procs = []
    for i, src in enumerate(sources):
        path = os.path.join(directory, f"{i}.png")
        target = ["-o", src["name"]] if src["kind"] == "screen" else ["-T", src["id"]]
        try:
            procs.append((src, path, subprocess.Popen(
                ["grim", "-s", str(THUMB_SCALE), *target, path],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)))
        except OSError:
            pass
    for src, path, proc in procs:
        try:
            if proc.wait(timeout=3) == 0 and os.path.getsize(path) > 0:
                src["thumb"] = path
        except (subprocess.TimeoutExpired, OSError):
            proc.kill()


CSS = """
window.share-picker { background-color: alpha(@bg, 0.75); }
.card {
  background-color: @bg;
  border: 2px solid @accent;
  border-radius: 12px;
  font-family: "JetBrains Mono";
  color: @fg;
}
.header { background-color: @bg_alt; padding: 16px 20px; border-radius: 10px 10px 0 0; }
.title { font-weight: bold; font-size: 13pt; }
.section { color: @fg_muted; margin: 16px 20px 6px; }
flowbox { margin: 0 12px; }
flowboxchild { padding: 0; background: none; }
button.tile {
  background: @bg;
  border: 2px solid @bg_alt;
  border-radius: 8px;
  padding: 10px;
  box-shadow: none;
  color: @fg;
}
button.tile:hover { background: @bg_alt; border-color: @accent; }
button.tile:active { background: shade(@bg_alt, 1.15); }
button.tile:focus-visible { outline: 2px solid @fg; outline-offset: 2px; }
.preview { background-color: shade(@bg, 0.8); border-radius: 4px; }
.placeholder { color: @fg_muted; }
.detail { color: @fg_muted; font-size: 9pt; }
.footer { border-top: 1px solid @bg_alt; padding: 12px 20px; }
.hint { color: @fg_muted; }
button.cancel {
  background: @bg_alt;
  color: @fg;
  border: 1px solid @bg_alt;
  border-radius: 6px;
  padding: 6px 16px;
  box-shadow: none;
}
button.cancel:hover { border-color: @accent; }
button.cancel:focus-visible { outline: 2px solid @fg; outline-offset: 2px; }
"""


class Picker(Gtk.Application):
    def __init__(self, sources, colors):
        super().__init__(application_id=None, flags=Gio.ApplicationFlags.NON_UNIQUE)
        self.sources = sources
        self.colors = colors
        self.choice = None

    def do_activate(self):
        provider = Gtk.CssProvider()
        defs = "".join(f"@define-color {k.lower()} {v};\n" for k, v in self.colors.items())
        provider.load_from_string(defs + CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_USER)
        Gtk.Settings.get_default().set_property("gtk-icon-theme-name", "breeze-dark")

        win = Gtk.Window(application=self, title="Share your screen")
        win.add_css_class("share-picker")
        LayerShell.init_for_window(win)
        LayerShell.set_layer(win, LayerShell.Layer.OVERLAY)
        LayerShell.set_namespace(win, "share-picker")
        LayerShell.set_keyboard_mode(win, LayerShell.KeyboardMode.EXCLUSIVE)
        for edge in (LayerShell.Edge.TOP, LayerShell.Edge.BOTTOM,
                     LayerShell.Edge.LEFT, LayerShell.Edge.RIGHT):
            LayerShell.set_anchor(win, edge, True)
        LayerShell.set_exclusive_zone(win, -1)

        card = self.build_card()
        card.set_halign(Gtk.Align.CENTER)
        card.set_valign(Gtk.Align.CENTER)
        win.set_child(card)

        # A click on the dimmed area outside the card cancels
        outside = Gtk.GestureClick()
        outside.connect("released", self.on_outside_click, card)
        win.add_controller(outside)

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self.on_key)
        win.add_controller(keys)

        win.present()

    def build_card(self):
        screens = [s for s in self.sources if s["kind"] == "screen"]
        windows = [s for s in self.sources if s["kind"] == "window"]
        if screens and windows:
            title = "Choose a screen or window to share"
        elif screens:
            title = "Choose a screen to share"
        else:
            title = "Choose a window to share"

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        card.add_css_class("card")

        header = Gtk.Box()
        header.add_css_class("header")
        label = Gtk.Label(label=title, xalign=0)
        label.add_css_class("title")
        header.append(label)
        card.append(header)

        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        body.set_margin_bottom(16)
        for name, group in (("Screens", screens), ("Windows", windows)):
            if not group:
                continue
            if screens and windows:
                section = Gtk.Label(label=name, xalign=0)
                section.add_css_class("section")
                body.append(section)
            else:
                body.append(Gtk.Box(margin_top=16))
            flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, homogeneous=True,
                               min_children_per_line=3, max_children_per_line=3,
                               column_spacing=12, row_spacing=12)
            for src in group:
                flow.append(self.build_tile(src))
            body.append(flow)

        scroller = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER,
                                      propagate_natural_height=True, max_content_height=640)
        scroller.set_child(body)
        card.append(scroller)

        footer = Gtk.Box(spacing=12)
        footer.add_css_class("footer")
        hint = Gtk.Label(label="Click a screen or window to share it", xalign=0, hexpand=True)
        if not (screens and windows):
            hint.set_label("Click a screen to share it" if screens else "Click a window to share it")
        hint.add_css_class("hint")
        cancel = Gtk.Button(label="Cancel")
        cancel.add_css_class("cancel")
        cancel.connect("clicked", lambda *_: self.finish(None))
        footer.append(hint)
        footer.append(cancel)
        card.append(footer)
        return card

    def build_tile(self, src):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)

        frame = Gtk.Overlay()
        frame.add_css_class("preview")
        frame.set_size_request(TILE_WIDTH, TILE_HEIGHT)
        texture = self.load_preview(src.get("thumb"))
        if texture:
            picture = Gtk.Picture.new_for_paintable(texture)
            picture.set_can_shrink(False)
            frame.set_child(picture)
        else:
            icon = Gtk.Image.new_from_icon_name("video-display" if src["kind"] == "screen" else "window")
            icon.set_pixel_size(48)
            icon.add_css_class("placeholder")
            frame.set_child(icon)
        box.append(frame)

        if src["kind"] == "screen":
            name = "Entire screen"
            detail = src["name"] + (f", {src['res']}" if src.get("res") else "")
        else:
            name = src["title"] or "Untitled window"
            detail = None
        label = Gtk.Label(label=name, ellipsize=3, max_width_chars=1, hexpand=True)
        label.set_tooltip_text(name)
        box.append(label)
        if detail:
            sub = Gtk.Label(label=detail, ellipsize=3, max_width_chars=1)
            sub.add_css_class("detail")
            box.append(sub)

        button = Gtk.Button(child=box)
        button.add_css_class("tile")
        button.set_cursor(Gdk.Cursor.new_from_name("pointer"))
        button.update_property([Gtk.AccessibleProperty.LABEL], [f"Share {name}"])
        button.connect("clicked", lambda *_: self.finish(src))
        return button

    @staticmethod
    def load_preview(path):
        """Scales a preview to fit the tile and centres it on a transparent tile-sized canvas.

        Gtk.Picture sizes itself from the image's aspect ratio, so a fixed canvas keeps
        every tile the same height whatever the shape of the screen or window."""
        if not path:
            return None
        try:
            scaled = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, TILE_WIDTH, TILE_HEIGHT, True)
            canvas = GdkPixbuf.Pixbuf.new(GdkPixbuf.Colorspace.RGB, True, 8, TILE_WIDTH, TILE_HEIGHT)
            canvas.fill(0)
            w, h = scaled.get_width(), scaled.get_height()
            scaled.copy_area(0, 0, w, h, canvas, (TILE_WIDTH - w) // 2, (TILE_HEIGHT - h) // 2)
            ok, png = canvas.save_to_bufferv("png", [], [])
            return Gdk.Texture.new_from_bytes(GLib.Bytes.new(png)) if ok else None
        except GLib.Error:
            return None

    def on_outside_click(self, gesture, n_press, x, y, card):
        win = gesture.get_widget()
        ok, bounds = card.compute_bounds(win)
        if ok and not bounds.contains_point(Graphene.Point().init(x, y)):
            self.finish(None)

    def on_key(self, controller, keyval, keycode, state):
        if keyval == Gdk.KEY_Escape:
            self.finish(None)
            return True
        return False

    def finish(self, src):
        self.choice = src
        self.quit()


def main():
    sources = parse_sources(sys.stdin.read().splitlines())
    if not sources:
        return 0
    res = resolutions()
    for src in sources:
        if src["kind"] == "screen":
            src["res"] = res.get(src["name"])
    with tempfile.TemporaryDirectory(prefix="share-picker.", dir=os.environ.get("XDG_RUNTIME_DIR")) as tmp:
        capture_thumbnails(sources, tmp)
        app = Picker(sources, read_palette())
        # Quit cleanly on SIGTERM/SIGINT so the preview directory is still removed
        for sig in (signal.SIGTERM, signal.SIGINT):
            GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, sig, lambda: (app.quit(), False)[1])
        app.run([sys.argv[0]])
    if app.choice:
        print(app.choice["line"], flush=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
